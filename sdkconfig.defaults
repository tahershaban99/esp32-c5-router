CONFIG_IDF_TARGET="esp32c5"
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_ESP_WIFI_MAX_CONN_NUM=12
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=12
CONFIG_ESP_NETIF_REPORT_DATA_TRAFFIC=y

# Wi-Fi throughput and buffer optimizations (tuned for low bufferbloat and maximum free heap RAM)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=40
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=y

# Disable heavy unused WPA3/SAE crypto tables to reclaim 15KB+ internal RAM for application
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n

# lwIP & FreeRTOS IRAM optimizations for maximum wire-speed throughput
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_EXTRA_IRAM_OPTIMIZATION=y
CONFIG_FREERTOS_IN_IRAM=y

# Compiler performance optimization (-O2 / -O3 for maximum throughput and low forwarding latency)
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# lwIP TCP window and buffer tuning (balanced for low RAM footprint, smooth wire forwarding, and low bufferbloat)
CONFIG_LWIP_TCP_MSS=1460
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=14600
CONFIG_LWIP_TCP_WND_DEFAULT=14600

# mbedTLS Dynamic Buffer allocation to minimize RAM usage during Telegram HTTPS calls
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y

# Maximum CPU clock (240MHz) and Flash SPI bus frequency (80MHz)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"

# 4MB Flash size and dual OTA app partition table (1.7MB each + rollback protection)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y
CONFIG_PARTITION_TABLE_FILENAME="partitions_two_ota_large.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

